[application]

config/name="LAST NIGHT"
config/icon="res://assets/ui/icon.png"
config/description="A 2D Survival Horror Zombie Apocalypse Game"
config/type="game"
config/features=PackedStringArray("PC", "Mobile", "iOS")
run/main_scene="res://scenes/main/main_menu.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/size/fullscreen_mode=2
window/size/borderless=false
window/size/always_on_top=false
window/size/width_override=0
window/size/height_override=0
window/handheld/orientation="landscape"
window/handheld/native_icon="res://assets/ui/icon.png"
window/vsync_mode=1
window/vsync_via_compositor=true

[rendering]

rendering/renderer/rendering_method="gl_compatibility"
rendering/2d/default_canvas_item_texture_filter=1
rendering/2d/batching/use_batching=true
rendering/environment/defaults/default_clear_color=Color(0.05, 0.05, 0.05, 1)

[physics]

physics/2d/default_gravity=980
physics/common/physics_ticks_per_second=60

[input]

input_devices/add_mouse=true
input_devices/add_touchscreen=true
input_devices/add_joypad=false

[autoload]

GameManager="res://scripts/autoload/game_manager.gd"
SaveManager="res://scripts/autoload/save_manager.gd"
AudioManager="res://scripts/autoload/audio_manager.gd"
InputManager="res://scripts/autoload/input_manager.gd"
UIManager="res://scripts/autoload/ui_manager.gd"
MissionManager="res://scripts/autoload/mission_manager.gd"
SurvivalManager="res://scripts/autoload/survival_manager.gd"
WorldManager="res://scripts/autoload/world_manager.gd"

[physics_layers_2d]

layer_1="player"
layer_2="enemy"
layer_3="world"
layer_4="projectile"
layer_5="interactable"
layer_6="trigger"

[layer_names_2d]

layer_1="player"
layer_2="enemy"
layer_3="world"
layer_4="projectile"
layer_5="interactable"
layer_6="trigger"

[input_map]

action_move_left=PackedStringArray("ui_left", "a", "gamepad_left_stick_left")
action_move_right=PackedStringArray("ui_right", "d", "gamepad_left_stick_right")
action_jump=PackedStringArray("ui_up", "w", "space", "gamepad_face_bottom")
action_crouch=PackedStringArray("ui_down", "s", "gamepad_face_left")
action_shoot=PackedStringArray("left_mouse", "gamepad_right_trigger")
action_aim=PackedStringArray("right_mouse", "gamepad_left_trigger")
action_reload=PackedStringArray("r", "gamepad_face_right")
action_interact=PackedStringArray("e", "gamepad_face_top")
action_flashlight=PackedStringArray("f", "gamepad_dpad_up")
action_inventory=PackedStringArray("i", "gamepad_dpad_down")
action_pause=PackedStringArray("ui_cancel", "escape", "gamepad_start")
action_weapon_1=PackedStringArray("1")
action_weapon_2=PackedStringArray("2")
action_weapon_3=PackedStringArray("3")
action_weapon_4=PackedStringArray("4")
action_run=PackedStringArray("shift", "gamepad_left_shoulder")

[rendering_materials]

rendering/materials/default_shader_item_material=""

[export]

export/debug_include_scenes=true